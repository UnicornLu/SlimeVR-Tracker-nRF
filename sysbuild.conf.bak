SB_CONFIG_BOOTLOADER_MCUBOOT=y

# ============================================================
# MCUboot UART DFU Configuration
# ============================================================
# Using UART DFU instead of USB to avoid USB device stack dependencies
# This file is for NCS 2.7.0+ sysbuild system

# ============================================================
# Basic kernel configuration for MCUboot
# ============================================================
CONFIG_MULTITHREADING=y
CONFIG_USERSPACE=n

# Serial/UART support (required for UART DFU)
# Note: CONFIG_UART doesn't exist, use CONFIG_SERIAL instead
# SERIAL_HAS_DRIVER and SERIAL_SUPPORT_INTERRUPT are internal symbols, don't set them
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# Logging support for debugging (using RTT instead of UART)
# This helps diagnose why MCUboot is not booting the application
CONFIG_LOG=y
CONFIG_LOG_MODE_IMMEDIATE=y
CONFIG_USE_SEGGER_RTT=y
CONFIG_LOG_BACKEND_RTT=y
CONFIG_UART_CONSOLE=y

# Console support (disabled - using RTT for logging instead)
# CONFIG_CONSOLE=y

# MCUboot serial recovery over UART
# BOOT_SERIAL_UART is a choice symbol, let MCUboot handle it
# Just ensure serial recovery is enabled

# ============================================================
# Library configuration
# ============================================================
CONFIG_MINIMAL_LIBC=y

# Main thread and heap configuration
CONFIG_MAIN_STACK_SIZE=1536
CONFIG_HEAP_MEM_POOL_SIZE=512
CONFIG_ISR_STACK_SIZE=1536

# ============================================================
# USB Configuration - DISABLED in MCUboot
# ============================================================
# CRITICAL: Disable USB device stack to avoid linker errors
# Use explicit "is not set" syntax for maximum priority
# CONFIG_USB_DEVICE_STACK is not set
# CONFIG_USB_CDC_ACM is not set
# CONFIG_USB_MASS_STORAGE is not set
# CONFIG_USB_DEVICE_DRIVER is not set
# CONFIG_BOOT_SERIAL_CDC_ACM is not set

# MCUboot configuration file should be automatically found at child_image/mcuboot/prj.conf
# If not automatically found, sysbuild may need to be configured differently
# The variable name MCUBOOT_CONFIG_FILE is not valid - removing explicit path

# MCUboot DTS overlay should be automatically found in boards/sysbuild/mcuboot.overlay
# If needed, uncomment and adjust path:
# SB_CONFIG_MCUBOOT_DTS_OVERLAY_FILE="boards/sysbuild/mcuboot.overlay"
