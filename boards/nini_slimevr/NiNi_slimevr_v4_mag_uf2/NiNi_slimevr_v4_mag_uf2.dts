// Based on NiNi_slimevr_v3_mag_uf2, with PWM RGB LED support

/dts-v1/;
#include <nordic/nrf52833_qdaa.dtsi>

&pinctrl {
	spi2_default: spi2_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MISO, 0, 31)>,
				<NRF_PSEL(SPIM_MOSI, 0, 30)>,
				<NRF_PSEL(SPIM_SCK, 0, 29)>;
		};
	};

	spi2_sleep: spi2_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_MISO, 0, 31)>,
				<NRF_PSEL(SPIM_MOSI, 0, 30)>,
				<NRF_PSEL(SPIM_SCK, 0, 29)>;
			low-power-enable;
		};
	};

	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
				<NRF_PSEL(TWIM_SCL, 0, 15)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
				<NRF_PSEL(TWIM_SCL, 0, 15)>;
			low-power-enable;
		};
	};

	pwm1_default: pwm1_default {
		group1 {
			/* RGB LED on P0.2, P0.3, P0.4 (example) */
			psels = <NRF_PSEL(PWM_OUT0, 0, 2)>,
				<NRF_PSEL(PWM_OUT1, 0, 3)>,
				<NRF_PSEL(PWM_OUT2, 0, 4)>;
		};
	};

	pwm1_sleep: pwm1_sleep {
		group1 {
			psels = <NRF_PIN_DISCONNECTED>;
			low-power-enable;
		};
	};

	ldo_ctrl_default: ldo_ctrl_default {
		group1 {
			psels = <NRF_PSEL(GPIO, 0, 5)>;
			nordic,drive-mode = <NRF_DRIVE_S0S1>;
		};
	};

	ldo_ctrl_sleep: ldo_ctrl_sleep {
		group1 {
			psels = <NRF_PSEL(GPIO, 0, 5)>;
			nordic,drive-mode = <NRF_DRIVE_S0S1>;
			low-power-enable;
		};
	};
};

/ {
	model = "nini_slimevr_v4_mag_uf2";
	compatible = "nini_slimevr_v4_mag_uf2";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio0 4 GPIO_OPEN_SOURCE>;
		};
	};

	ldo_en: ldo-en {
		compatible = "gpio-ldo";
		gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button switch 0";
		};
		button1: button_1 {
			gpios = <&gpio0 18 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button switch 1";
		};
	};

	aliases {
		sw0 = &button0;
		sw1 = &button1;
		led0 = &led0;
	};

	pwmclock: pwmclock {
		compatible = "pwm-clock";
		#clock-cells = <1>;
		pwms = <&pwm1 0 PWM_HZ(32768) PWM_POLARITY_NORMAL>;
	};

	battery-divider {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc 12>; /* Measure VDDHDIV5 */
		output-ohms = <1>;
		full-ohms = <5>;
	};

	zephyr,user {
		int0-gpios = <&gpio0 3 0>;
		led0-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		chg-gpios = <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		ldo-gpios = <&gpio1 9 GPIO_PUSH_PULL>;
		/* RGB LED channels driven by PWM1 CH0/1/2 */
		rgb-red-pwms   = <&pwm1 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		rgb-green-pwms = <&pwm1 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		rgb-blue-pwms  = <&pwm1 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
	};
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_LDO>;
};

&adc {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
	ldo_en_sleep: ldo-en-sleep {
		gpio-hog;
		gpios = <9 GPIO_PULL_DOWN>;
		input;
	};
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&nfct {
	status = "disabled";
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_default>;
	pinctrl-1 = <&pwm1_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi2 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;

	imu_spi: imu@0 {
		compatible = "vnd,spi-device";
		spi-max-frequency = <DT_FREQ_M(24)>;
		label = "imu-spi";
		reg = <0>;
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	zephyr,concat-buf-size = <1023>;
	zephyr,flash-buf-max-size = <1023>;
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	mag: mag@0 {
		compatible = "i2c-device";
		label = "mag";
		reg = <0>;
		irq-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
	};
};


