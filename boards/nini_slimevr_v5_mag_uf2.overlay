/ {
	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button switch 0";
		};
		button1: button_1 {
			gpios = <&gpio0 18 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button switch 1";
		};
	};

	pwmclock: pwmclock {
		compatible = "pwm-clock";
		#clock-cells = <1>;
		pwms = <&pwm1 0 PWM_HZ(32768) PWM_POLARITY_NORMAL>;
	};

	aliases {
		sw0 = &button0;
		sw1 = &button1;
		led-strip = &led_strip;
		imu0 = &imu_spi;
	};
};

&pinctrl {
	spi2_default: spi2_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MISO, 0, 31)>,
				<NRF_PSEL(SPIM_MOSI, 0, 30)>,
				<NRF_PSEL(SPIM_SCK,  0, 29)>;
			bias-disable;
		};
	};

	spi2_sleep: spi2_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_MISO, 0, 31)>,
				<NRF_PSEL(SPIM_MOSI, 0, 30)>,
				<NRF_PSEL(SPIM_SCK,  0, 29)>;
			low-power-enable;
		};
	};

	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
				<NRF_PSEL(TWIM_SCL, 0, 15)>;
			bias-disable;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
				<NRF_PSEL(TWIM_SCL, 0, 15)>;
			low-power-enable;
		};
	};

	/* WS2812 data output: spi1 MOSI on P0.20 */
spi1_ws2812_default: spi1_ws2812_default {
  group1 {
    psels = <NRF_PSEL(SPIM_MOSI, 0, 20)>;
    bias-disable;
  };
};

spi1_ws2812_sleep: spi1_ws2812_sleep {
  group1 {
    psels = <NRF_PIN_DISCONNECTED>;
    low-power-enable;
  };
};
};

&spi1 {
  status = "okay";
  compatible = "nordic,nrf-spim";
  pinctrl-0 = <&spi1_ws2812_default>;
  pinctrl-1 = <&spi1_ws2812_sleep>;
  pinctrl-names = "default", "sleep";

  	/* WS2812B (XL-1615RGBC-WS2812B-S) on P0.20 via spi1-MOSI */
	led_strip: ws2812@0 {
  		compatible = "worldsemi,ws2812-spi";
  		reg = <0>;
 	 	spi-max-frequency = <DT_FREQ_M(3)>;
 		 chain-length = <1>;
 		 color-mapping = <LED_COLOR_ID_GREEN
               			    LED_COLOR_ID_RED
                 		  LED_COLOR_ID_BLUE>;
		spi-one-frame = <1>;
   		spi-zero-frame = <1>;
};
};

&spi2 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";

	cs-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;

	imu_spi: imu@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		label = "imu-spi";
		spi-max-frequency = <DT_FREQ_M(24)>;
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	zephyr,concat-buf-size = <1023>;
	zephyr,flash-buf-max-size = <1023>;
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	mag: mag@0 {
		compatible = "i2c-device";
		label = "mag";
		reg = <0>;
	};
};


