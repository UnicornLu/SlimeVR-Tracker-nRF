/ {
	sram0@2001f000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2001f000 0x1000>;
		zephyr,memory-region = "RETAINED_MEM";
		status = "okay";

		retainedmem0: retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
		};
	};

	sram0@20007f7c {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x20007f7c 4>;
		zephyr,memory-region = "DFU_DBL_RESET_MEM";
		status = "okay";

		retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
		};
	};

	aliases {
		retainedmemdevice = &retainedmem0;
	};
};

/ {
    /* Define SRAM region explicitly (board may be using stub.dts, so &sram0 doesn't exist) */
    sram0: sram@20000000 {
        compatible = "zephyr,memory-region", "mmio-sram";
        reg = <0x20000000 0x1F000>; /* 124 KiB */
        zephyr,memory-region = "SRAM";
        status = "okay";
    };
};
