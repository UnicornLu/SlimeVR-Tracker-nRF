mcuboot:
  address: 0x00000000
  size:    0x00010000

mcuboot_pad:
  address: 0x00010000
  size:    0x00000200

mcuboot_primary:
  address: 0x00010000
  size:    0x0003F000   # 例子：你可以把它加大

mcuboot_secondary:
  address: 0x0004F000   # 要跟 primary_end 对齐接上（示例）
  size:    0x00020000   # 例子：缩小 slot1

nvs_storage:
  address: 0x00074000   # 例子：你保持末尾区域
  size:    0x00006000

storage:
  address: 0x0007A000
  size:    0x00006000
